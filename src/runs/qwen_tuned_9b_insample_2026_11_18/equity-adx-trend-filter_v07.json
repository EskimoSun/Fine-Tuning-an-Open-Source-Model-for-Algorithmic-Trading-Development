    "source": "# region imports\nfrom AlgorithmImports import *\n# endregion\n\n\nclass EquityADXTrendFilterAlgorithm(QCAlgorithm):\n\n    def initialize(self) -> None:\n        self.set_start_date(2024, 9, 1)\n        self.set_end_date(2024, 12, 31)\n        self.set_cash(100_000)\n        # automatic_indicator_warm_up only supports automatic indicators, not manual indicators.\n        self.settings.automatic_indicator_warm_up = True\n        self._equity = self.add_equity(\"SPY\")\n        for window, name in [(12, \"SPY12\"), (26, \"SPY26\"), (52, \"SPY52\")]:\n            ema = self.ema(self._equity, window, Resolution.DAILY)\n            # Alternatively, use a manual indicator.\n            # ema = ExponentialMovingAverage(window)\n            # self.warm_up_indicator(self._equity, ema, Resolution.DAILY)\n            # self.register_indicator(self._equity, ema, Resolution.DAILY)\n            ema.name = name\n            self.plot(ema.name, ema.current.value)\n        self.schedule.on(\n            self.date_rules.every_day(self._equity),\n            self.time_rules.after_market_open(self._equity, 1),\n            self._rebalance\n        )\n\n    def _rebalance(self) -> None:\n        if not self._equity.invested:\n            ema12 = self.indicators[\"SPY12\"]\n            ema26 = self.indicators[\"SPY26\"]\n            ema52 = self.indicators[\"SPY52\"]\n            price = self.securities[self._equity].price\n            if (price > ema12.current.value and ema12.current.value > ema26.current.value and ema26.current.value > ema52.current.value or\n                price < ema12.current.value and ema12.current.value < ema26.current.value and ema26.current.value < ema52.current.value):\n                self.set_holdings(self._equity, 1)\n",
