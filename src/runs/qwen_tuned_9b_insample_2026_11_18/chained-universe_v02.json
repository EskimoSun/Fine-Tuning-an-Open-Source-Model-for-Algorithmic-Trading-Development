  "system_prompt": "v1",
  "output": "```python\n# region imports\nfrom AlgorithmImports import *\n# endregion\n\nclass ETFUniverseAlgorithm(QCAlgorithm):\n    _weight_by_symbol: dict[Symbol, float] = {}\n\n    def initialize(self) -> None:\n        self.set_start_date(2024, 9, 1)\n        self.set_end_date(2024, 12, 31)\n        self.set_cash(100000)\n        self.settings.seed_initial_prices = True\n        # automatic_indicator_warm_up only supports automatic indicators, not manual indicators.\n        self.settings.automatic_indicator_warm_up = True\n        # Select QQQ constituents first, then by fundamental data.\n        self._universe = self.add_universe(self.universe.etf(\"QQQ\", self._etf_constituents_filter))\n        self.schedule.on(self.date_rules.every_day(\"QQQ\"), self.time_rules.before_market_open(\"QQQ\", 30), self._place_orders)\n\n    def on_securities_changed(self, changes: SecurityChanges) -> None:\n        for security in changes.added_securities:\n            if not security.fundamental:\n                continue\n            # Add PE ratio to calculate the optimal trade weights.\n            security.pe_ratio = self.pe(security)\n            # If PE ratio is not valid, it will be removed in the universe selection.\n            self._weight_by_symbol[security.symbol] = security.fundamental.pe_ratio\n\n    def _etf_constituents_filter(self, constituents: List[ETFConstituentUniverse]) -> List[Symbol]:\n        # Select all QQQ constituents.\n        symbols = [c.symbol for c in constituents]\n        # Select the stocks with the lowest PE ratio.\n        self._weight_by_symbol = {s: self._weight_by_symbol.get(s, 0) for s in symbols}\n        pe_ratio_by_symbol = sorted(self._weight_by_symbol.items(), key=lambda x: x[1])\n        selected = [s for s, _ in pe_ratio_by_symbol[:10]]\n        self.plot(\"Universe\", \"Selected\", len(selected))\n        return selected\n\n    def _place_orders(self) -> None:\n        if not self._universe.selected:\n            return\n        # Select the stocks with the lowest PE ratio.\n        pe_ratio_by_symbol = sorted(self._weight_by_symbol.items(), key=lambda x: x[1])\n        selected = [s for s, _ in pe_ratio_by_symbol[:10]]\n        if not selected:\n            return\n        # We will keep the ETF weights by scale it up to sum 1\n        sum_of_weight = sum([self._weight_by_symbol[symbol] for symbol in selected])\n        self.plot(\"Universe\", \"Sum Of Weight (%)\", sum_of_weight * 100)\n        if not sum_of_weight:\n            return\n        targets = [PortfolioTarget(symbol, self._weight_by_symbol[symbol] / sum_of_weight) for symbol in selected]\n        # Remove securities that are no longer in the fundamental dataset\n        self.set_holdings(targets, True)\n```",
