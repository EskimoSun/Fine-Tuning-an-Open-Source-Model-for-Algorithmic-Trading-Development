    "source": "# region imports\nfrom AlgorithmImports import *\n# endregion\n\nclass EquityRSITradingAlgorithm(QCAlgorithm):\n    def initialize(self) -> None:\n        self.set_start_date(2024, 9, 1)\n        self.set_end_date(2024, 12, 31)\n        self.set_cash(100000)\n        # automatic_indicator_warm_up only supports automatic indicators, not manual indicators.\n        self.settings.automatic_indicator_warm_up = True\n\n        self._qqq = self.add_equity(\"QQQ\", Resolution.HOUR)\n        self._rsi = self.rsi(self._qqq.symbol, 14, MovingAverageType.WILDERS)\n        # Alternatively, use a manual indicator.\n        # self._rsi = RelativeStrengthIndex(14)\n        # self.warm_up_indicator(self._qqq, self._rsi)\n        # self.register_indicator(self._qqq, self._rsi)\n        self.plot_indicator(\"RSI\", self._rsi)\n\n        self._long_threshold = 30\n        self._short_threshold = 70\n        self._stop_loss = 0.02\n        self._take_profit = 0.03\n\n        self.schedule.on(\n            self.date_rules.every_day(self._qqq.symbol),\n            self.time_rules.after_market_open(self._qqq.symbol, 30),\n            self._rebalance\n        )\n\n    def _rebalance(self) -> None:\n        if not self._rsi.is_ready:\n            return\n\n        rsi_value = self._rsi.current.value\n        quantity = self._qqq.holdings.quantity\n\n        if self.portfolio.invested:\n            if (quantity > 0 and rsi_value > self._short_threshold or\n                quantity < 0 and rsi_value < self._long_threshold):\n                self.liquidate(self._qqq.symbol)\n            elif not self._qqq.stop_loss_order.placed and abs(self._qqq.holdings.quantity) > 0:\n                self._place_trailing_protection()\n\n        elif rsi_value < self._long_threshold:\n            self.set_holdings(self._qqq.symbol, 1.0)\n        elif rsi_value > self._short_threshold:\n            self.set_holdings(self._qqq.symbol, -1.0)\n\n    def _place_trailing_protection(self) -> None:\n        quantity = self._qqq.holdings.quantity\n        if quantity > 0:\n            self.stop_market_order(self._qqq.symbol, -1.0)\n        elif quantity < 0:\n            self.stop_market_order(self._qqq.symbol, 1.0)\n",
