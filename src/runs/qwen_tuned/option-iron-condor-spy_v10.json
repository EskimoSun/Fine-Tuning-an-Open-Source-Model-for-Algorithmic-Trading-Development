  "system_prompt": "v1",
  "output": "```python\n# region imports\nfrom AlgorithmImports import *\n# endregion\n\nclass EquityOptionAlgorithm(QCAlgorithm):\n    _option: OptionContract = None\n\n    def initialize(self) -> None:\n        self.set_start_date(2024, 9, 1)\n        self.set_end_date(2024, 12, 31)\n        self.set_cash(100000)\n        self.settings.seed_initial_prices = True\n\n        self._option = self.add_option(\"SPY\")\n        # Using Staddle() method, it will only return the best-matched contract that expires after a certain date.\n        # It provides better accuracy in filtering, and avoid unnecessary computation on the entire option universe.\n        # It returns an OptionFilter object that can be used to filter the option contracts.\n        self._option.set_filter(lambda u: u.strikes(-10, 10).expiration(0, 7))\n        \n        self.schedule.on(self.date_rules.every(DayOfWeek.MONDAY), self.time_rules.after_market_open(self._option, 1), self._open_iron_condor)\n        self.schedule.on(self.date_rules.every(DayOfWeek.FRIDAY), self.time_rules.before_market_close(self._option, 5), self._close)\n\n    def _open_iron_condor(self) -> None:\n        if not self._option.is_ready:\n            return\n        next_friday = (self.time + timedelta(4)).date()\n        \n        chain = sorted([x for x in self.option_chain(self._option) if x.expiry.date() == next_friday],\n            key=lambda x: x.strike)\n        \n        if not chain:\n            return\n\n        strike = chain[0].strike\n        atm_call = next((x for x in chain if x.right == OptionRight.CALL and abs(strike - x.strike) < 5), None)\n        atm_put = next((x for x in chain if x.right == OptionRight.PUT and abs(strike - x.strike) < 5), None)\n        \n        if not (atm_call and atm_put):\n            return\n\n        otm_call = next((x for x in chain if x.right == OptionRight.CALL and x.strike > strike + 5), None)\n        otm_put = next((x for x in chain if x.right == OptionRight.PUT and x.strike < strike - 5), None)\n        \n        if not (otm_call and otm_put):\n            return\n\n        iron_condor = OptionStrategies.iron_condor(self._option.symbol, atm_put.strike, atm_call.strike, otm_call.strike, next_friday)\n        self.buy(iron_condor, 1)\n\n    def _close(self) -> None:\n        self.liquidate()\n```",
