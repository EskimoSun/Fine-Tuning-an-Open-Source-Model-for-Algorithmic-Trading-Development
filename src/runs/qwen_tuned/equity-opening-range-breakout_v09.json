    "source": "# region imports\nfrom AlgorithmImports import *\n# endregion\n\nclass EquityOpenRangeBreakoutAlgorithm(QCAlgorithm):\n    _long_threshold = 0.01\n    _short_threshold = -0.01\n\n    def initialize(self) -> None:\n        self.set_start_date(2024, 9, 1)\n        self.set_end_date(2024, 12, 31)\n        self.set_cash(100000)\n\n        # automatic_indicator_warm_up only supports automatic indicators, not manual indicators.\n        self.settings.automatic_indicator_warm_up = True\n\n        self._spy = self.add_equity(\"SPY\", Resolution.MINUTE)\n\n        self._range_high = RollingWindow[float](30)\n        self._range_low = RollingWindow[float](30)\n        self._previous_bar_close = RollingWindow[float](1)\n\n        self.schedule.on(\n            self.date_rules.every_day(self._spy.symbol),\n            self.time_rules.after_market_open(self._spy.symbol, 30),\n            self._enter_exit_portfolio\n        )\n\n    def on_data(self, data: Slice) -> None:\n        bar = data.bars.get(self._spy.symbol)\n        if not bar:\n            return\n\n        # Warm up the range and close watermarks using only the current bar.\n        if self._range_high.is_warming_up and self._previous_bar_close.is_warming_up:\n            self._range_high.update(bar.end_time, bar.high)\n            self._range_low.update(bar.end_time, bar.low)\n            self._previous_bar_close.update(bar.end_time, bar.close)\n\n        # Exit on break of the price band.\n        last_close = self._previous_bar_close.current.value\n        if (not self._range_high.is_ready and last_close > self._range_high.maximum.value or\n            not self._range_low.is_ready and last_close < self._range_low.minimum.value):\n            self.liquidate(self._spy.symbol)\n            self._range_high.clear()\n            self._range_low.clear()\n            self._previous_bar_close.clear()\n            return\n\n        self._previous_bar_close.update(bar.end_time, bar.close)\n\n        # Entry on break of the open range.\n        range_high = self._range_high.current.value\n        range_low = self._range_low.current.value\n\n        if not self._spy.invested and range_high > last_close + self._long_threshold:\n            self.set_holdings(self._spy.symbol, 1.0)\n        elif not self._spy.invested and range_low < last_close - self._short_threshold:\n            self.set_holdings(self._spy.symbol, -1.0)\n\n    def _enter_exit_portfolio(self) -> None:\n        if self.portfolio.invested:\n            self.liquidate()\n        self._range_high.clear()\n        self._range_low.clear()\n",
