  "output": "```python\n# region imports\nfrom AlgorithmImports import *\n# endregion\n\nclass SP500HighMomentumUniverseAlgorithm(QCAlgorithm):\n    def initialize(self) -> None:\n        self.set_start_date(2022, 1, 1)\n        self.set_end_date(2024, 12, 31)\n        self.set_cash(250000)\n\n        self.universe_settings.resolution = Resolution.MINUTE\n        # Select SPY constituents first, then by fundamental data.\n        self.add_universe(self.universe.etf(\"SPY\"))\n\n        self.schedule.on(\n            self.date_rules.month_start(),\n            self.time_rules.at(9, 35),\n            self._rebalance\n        )\n\n    def _rebalance(self) -> None:\n        if not self.universe.selected:\n            return\n\n        # Select stocks with positive 12-month momentum, ranked by dollar volume.\n        universe = self.universe.selected\n        selected = [\n            x.symbol\n            for x in sorted(\n                [x for x in universe if x.momentum(12).value > 0],\n                key=lambda x: x.dollar_volume, reverse=True\n            )[:100]\n        ]\n\n        if not selected:\n            return\n\n        weight = 1 / len(selected)\n        targets = [PortfolioTarget(symbol, weight) for symbol in selected]\n\n        self.set_holdings(targets, liquidate_existing_holdings=True)\n```",
