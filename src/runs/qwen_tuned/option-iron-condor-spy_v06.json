  "output": "```python\n# region imports\nfrom AlgorithmImports import *\n# endregion\n\nclass EquityOptionAlgorithm(QCAlgorithm):\n    _wing_delta = 0.10\n\n    def initialize(self) -> None:\n        self.set_start_date(2024, 9, 1)\n        self.set_end_date(2024, 12, 31)\n        self.set_cash(100000)\n        self.universe_settings.minimum_time_in_universe = timedelta(0)\n\n        self._option = self.add_option(\"SPY\")\n        self.schedule.on(self.date_rules.every(DayOfWeek.MONDAY), self.time_rules.at(9, 0), self._buildIronCondor)\n        self.schedule.on(self.date_rules.every(DayOfWeek.FRIDAY), self.time_rules.at(17, 0), self.liquidate)\n\n    def _buildIronCondor(self) -> None:\n        if self._option.invested:\n            return\n        chain = self.option_chain(self._option.symbol)\n        expiry = min([x.expiry for x in chain if x.right == OptionRight.CALL])\n        filtered = [x for x in chain if x.expiry == expiry and abs(x.strike - self._option.symbol.price) <= 10]\n        if len(filtered) < 4:\n            return\n        strikes = sorted(set([x.strike for x in filtered]))\n        wing_delta = self._wing_delta\n        calls = [x for x in filtered if x.strike == max(strikes[:-3]) and abs(self._option.symbol.price - x.strike) / x.strike < wing_delta]\n        puts = [x for x in filtered if x.strike == min(strikes[3:]) and abs(self._option.symbol.price - x.strike) / x.strike < wing_delta]\n        if not calls or not puts:\n            return\n        iron_condor = OptionStrategy.createIronCondor(calls[0].symbol, puts[0].symbol, strike_spread=sorted(strikes)[2:-2])\n        self.add_option_strategy(iron_condor)\n```",
